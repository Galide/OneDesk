#!/bin/bash
# Stop the previous agent before replacing the app bundle.
set -u

LABEL="com.onedesk.client"
APP="/Applications/OneDesk.app"

console_user="$(/usr/bin/stat -f "%Su" /dev/console 2>/dev/null || true)"
if [ -n "$console_user" ] && [ "$console_user" != "root" ] && [ "$console_user" != "loginwindow" ]; then
    uid="$(/usr/bin/id -u "$console_user" 2>/dev/null || true)"
    if [ -n "$uid" ]; then
        /bin/launchctl bootout "gui/$uid/$LABEL" >/dev/null 2>&1 || true
    fi
fi

/usr/bin/pkill -f "$APP/Contents/MacOS/OneDesk" >/dev/null 2>&1 || true
exit 0
