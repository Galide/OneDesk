* text=auto

# Shell scripts and macOS package metadata must keep LF endings.
*.sh text eol=lf
*.plist text eol=lf
*.entitlements text eol=lf
installer/macos/scripts/* text eol=lf
installer/macos/Distribution.xml text eol=lf

# Windows build files keep CRLF endings.
*.ps1 text eol=crlf
*.iss text eol=crlf
*.sln text eol=crlf
